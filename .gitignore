# Jekyll build output and caches (regenerated by `jekyll build`)
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Ruby / Bundler
Gemfile.lock
vendor/
.bundle/
*.gem

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Session / scratch artifacts (not part of the site)
*.log
log.txt
copilot-session.md

# Local-only media tooling (fonts + video generators; not needed to display the site)
site/assets/media/blog/script/

# Disposable video backups created by tools/convert_videos.sh
*_bk.mp4
*_bk.mov
*_bk.webm

# Python tooling caches
__pycache__/
*.pyc
